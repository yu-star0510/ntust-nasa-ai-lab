# M0: only the governance files named in WO-M0-001 may be staged.
/*
!/.gitignore
!/AGENTS.md
!/ROADMAP.md
!/WORK_ITEM.md
!/DECISIONS.md

# Keep these exclusions if a later work item expands the root allowlist.
synthetic_sensor.csv
train_FD001.txt
test_FD001.txt
RUL_FD001.txt
FD001/
data/
datasets/
private/
research/
.env
.env.*
*.env
.npmrc
.netrc
*.pem
*.key
*.pfx
*.p12
*credential*
*password*
*secret*
*token*

